<Window
	x:Class="application.MVVM.View.AdminView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:local="clr-namespace:application.MVVM.View"
	xmlns:viewmodel="clr-namespace:application.MVVM.ViewModel"
	mc:Ignorable="d"
	MinWidth="1000"
	MinHeight="600"
	Title="AdminWindow"
	WindowStartupLocation="CenterScreen"
	Loaded="Window_Loaded">
	
	<Window.Resources>
		<Storyboard
			x:Key="ExpandStoryboard">
			<DoubleAnimation
				Storyboard.TargetName="SideMenu"
				Storyboard.TargetProperty="Width"
				To="230"
				Duration="0:0:0.3" />
		</Storyboard>
		<Storyboard
			x:Key="CollapseStoryboard">
			<DoubleAnimation
				Storyboard.TargetName="SideMenu"
				Storyboard.TargetProperty="Width"
				To="63"
				Duration="0:0:0.3" />
		</Storyboard>
	</Window.Resources>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="auto" />
			<ColumnDefinition
				Width="*" />
		</Grid.ColumnDefinitions>

		<Border
			Style="{StaticResource MenuBorder}"
			CornerRadius="0,6,6,0"
			Background="#f7f7f7"
			Width="63"
			x:Name="SideMenu">

			<Grid>

				<Grid.RowDefinitions>
					<RowDefinition
						Height="*" />
					<RowDefinition
						Height="auto" />
				</Grid.RowDefinitions>

				<StackPanel
					Orientation="Vertical"
					VerticalAlignment="Top">

					<Border
						Style="{StaticResource MenuBorder}"
						CornerRadius="0 6 0 0">
						<RadioButton
							Margin="10 5 0 5"
							Command="{Binding OpenMenuCommand}"
							Style="{StaticResource MenuShowButton}"
							Content="Hide"
							Tag="../../Assets/Icons/List.png" />
					</Border>

					<Border
						Style="{StaticResource MenuBorder}">
						<StackPanel
							Margin="10 5 0 5"
							VerticalAlignment="Center"
							HorizontalAlignment="Stretch"
							Orientation="Horizontal">

							<RadioButton
								Command="{Binding AccountCommand}"
								x:Name="Account"
								Height="40"
								Width="40"
								Style="{StaticResource MenuAvatar}"
								Checked="RadioButton_Checked">
								<Image
									Source="../../Assets/Icons/Ava.png"
									Width="40"
									Height="40" />
							</RadioButton>

							<StackPanel
								Orientation="Vertical">

								<Label
									Margin="20 0 0 0"
									Content="Фамилия И. О."
									FontSize="16"
									Style="{StaticResource MenuText}" />

								<Label
									Margin="20 -10 0 0"
									Content="test_email@yandex.com"
									FontSize="12"
									Style="{StaticResource MenuText}" />

							</StackPanel>

						</StackPanel>
					</Border>

					<Border
						Style="{StaticResource MenuBorder}">
						<RadioButton
							Margin="10 5 0 5"
							Command="{Binding CompanyCommand}"
							x:Name="Company"
							Style="{StaticResource MenuRadioButton}"
							Checked="RadioButton_Checked"
							Content="Company"
							Tag="../../Assets/Icons/Trending up.png" />
					</Border>

					<Border
						Style="{StaticResource MenuBorder}">
						<RadioButton
							Margin="10 5 0 5"
							Command="{Binding EntityManagersCommand}"
							x:Name="EntityManagers"
							Style="{StaticResource MenuRadioButton}"
							Checked="RadioButton_Checked"
							Content="EntityManagers"
							Tag="../../Assets/Icons/Dollar.png" />
					</Border>

					<Border
						Style="{StaticResource MenuBorder}">
						<RadioButton
							Margin="10 5 0 5"
							Command="{Binding EntityProductOrderCommand}"
							x:Name="EntityProductOrder"
							Style="{StaticResource MenuRadioButton}"
							Checked="RadioButton_Checked"
							Content="EntityProductOrder"
							Tag="../../Assets/Icons/Person.png" />
					</Border>

					<Border
						Style="{StaticResource MenuBorder}">
						<RadioButton
							Margin="10 5 0 5"
							Command="{Binding EntityStorageCommand}"
							x:Name="EntityStorage"
							Style="{StaticResource MenuRadioButton}"
							Checked="RadioButton_Checked"
							Content="EntityStorage"
							Tag="../../Assets/Icons/Person.png" />
					</Border>

					<Border
						Style="{StaticResource MenuBorder}">
						<RadioButton
							Margin="10 5 0 5"
							Command="{Binding EntityCommand}"
							x:Name="Entity"
							Style="{StaticResource MenuRadioButton}"
							Checked="RadioButton_Checked"
							Content="Entity"
							Tag="../../Assets/Icons/Person.png" />
					</Border>

					<Border
						Style="{StaticResource MenuBorder}">
						<RadioButton
							Margin="10 5 0 5"
							Command="{Binding OrderCommand}"
							x:Name="Order"
							Style="{StaticResource MenuRadioButton}"
							Checked="RadioButton_Checked"
							Content="Order"
							Tag="../../Assets/Icons/Person.png" />
					</Border>

					<Border
						Style="{StaticResource MenuBorder}">
						<RadioButton
							Margin="10 5 0 5"
							Command="{Binding ProductCommand}"
							x:Name="Product"
							Style="{StaticResource MenuRadioButton}"
							Checked="RadioButton_Checked"
							Content="Product"
							Tag="../../Assets/Icons/Person.png" />
					</Border>

					<Border
						Style="{StaticResource MenuBorder}">
						<RadioButton
							Margin="10 5 0 5"
							Command="{Binding SupportTableCommand}"
							x:Name="SupportTable"
							Style="{StaticResource MenuRadioButton}"
							Checked="RadioButton_Checked"
							Content="SupportTable"
							Tag="../../Assets/Icons/Person.png" />
					</Border>

					<Border
						Style="{StaticResource MenuBorder}">
						<RadioButton
							Margin="10 5 0 5"
							Command="{Binding UserCommand}"
							x:Name="User"
							Style="{StaticResource MenuRadioButton}"
							Checked="RadioButton_Checked"
							Content="User"
							Tag="../../Assets/Icons/Person.png" />
					</Border>

				</StackPanel>

				<StackPanel
					Orientation="Vertical"
					VerticalAlignment="Bottom">

					<Border
						Style="{StaticResource MenuBorder}"
						CornerRadius="0 0 6 0">
						<RadioButton
							Margin="10 5 0 5"
							Command="{Binding InfoCommand}"
							x:Name="Info"
							Style="{StaticResource MenuRadioButton}"
							Checked="RadioButton_Checked"
							Content="Info"
							Tag="../../Assets/Icons/Info.png" />
					</Border>

				</StackPanel>

			</Grid>
		</Border>

		<ContentControl
			Grid.Column="1"
			x:Name="Pages"
			Content="{Binding CurrentView}" />

	</Grid>

</Window>
