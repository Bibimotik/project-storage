<UserControl
	x:Class = "application.MVVM.View.Pages.AddProductView"
	xmlns = "http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x = "http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc = "http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d = "http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local = "clr-namespace:application.MVVM.View.Pages"
	mc:Ignorable = "d">
	
	<StackPanel
		Width="300"
		Margin="50 0 50 0"
		Orientation="Vertical"
		VerticalAlignment="Center">

		<Label
			FontSize="45"
			Content="Add product" />
		
		<TextBlock Margin="0 0 0 8" Text="Code" />
		<TextBox Width="300" Style="{StaticResource AuthInput}" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />

		<TextBlock Margin="0 0 0 8" Text="Title" />
		<TextBox Width="300" Style="{StaticResource AuthInput}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

		<TextBlock Margin="0 0 0 8" Text="Unit" />
		<TextBox Width="300" Style="{StaticResource AuthInput}" Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" />

		<TextBlock Margin="0 0 0 8" Text="Price" />
		<TextBox Width="300" Style="{StaticResource AuthInput}" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" />
		
		<TextBlock Margin="0 0 0 8" Text="Party" />
		<TextBox Width="300" Style="{StaticResource AuthInput}" Text="{Binding Party, UpdateSourceTrigger=PropertyChanged}" />

		<TextBlock Margin="0 0 0 8" Text="Available for shipment" />
		<TextBox Width="300" Style="{StaticResource AuthInput}" Text="{Binding AvailableForShipment, UpdateSourceTrigger=PropertyChanged}" />

		<TextBlock Margin="0 0 0 8" Text="Implementation period" />
		<TextBox Width="300" Style="{StaticResource AuthInput}" Text="{Binding ImplementationPeriod, UpdateSourceTrigger=PropertyChanged}" />

		<TextBlock Margin="0 0 0 8" Text="Expiration date" />
		<TextBox Width="300" Style="{StaticResource AuthInput}" Text="{Binding ExpirationDate, UpdateSourceTrigger=PropertyChanged}" />

		<TextBlock Margin="0 0 0 8" Text="Image" />
		<Button
			Height="25"
			Content="{Binding SelectedFilePath}"
			Command="{Binding SelectFileCommand}" 
			Style="{StaticResource SendButtonWhite}" />

		<Button
			Content="Add product"
			Foreground="#ffffff"
			Width="120"
			Margin="0,20"
			Style="{StaticResource SendButton}"
			Command="{Binding AddProductCommand}" />

		<Button 
			Content="Back"
			Height="25"
			Width="80"
			VerticalAlignment="Center" 
			Command="{Binding TriggerBackProductCommand}"
			Style="{StaticResource SendButtonWhite}" />
	</StackPanel>
	
</UserControl>
