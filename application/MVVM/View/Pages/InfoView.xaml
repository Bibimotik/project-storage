<UserControl
	x:Class="application.MVVM.View.Pages.InfoView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:application.MVVM.View.Pages"
	xmlns:Pages="clr-namespace:application.MVVM.ViewModel.Pages"
	mc:Ignorable="d"
	d:DesignHeight="300"
	d:DesignWidth="300">

	<UserControl.DataContext>
		<Pages:InfoViewModel/>
	</UserControl.DataContext>

	<StackPanel Width="300" Margin="10">
		<Label FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,10">Warehouse Management Application</Label>
		<TextBlock TextWrapping="Wrap" Margin="0,10,0,10">
			This application is designed to streamline warehouse operations by providing a user-friendly interface 
			for managing inventory, tracking orders, and generating reports. With its robust features and intuitive design, 
			users can efficiently organize and monitor all warehouse activities.
		</TextBlock>
		<TextBlock TextWrapping="Wrap" Margin="0,10,0,10">
			Key features include:
		</TextBlock>
		<TextBlock TextWrapping="Wrap" Margin="20,0,0,10">
			- Real-time inventory tracking
		</TextBlock>
		<TextBlock TextWrapping="Wrap" Margin="20,0,0,10">
			- Order management and status updates
		</TextBlock>
		<TextBlock TextWrapping="Wrap" Margin="20,0,0,10">
			- Detailed reporting and analytics
		</TextBlock>
		<TextBlock TextWrapping="Wrap" Margin="0,10,0,10">
			Simplify your warehouse operations today with our comprehensive management tool.
		</TextBlock>
	</StackPanel>
</UserControl>