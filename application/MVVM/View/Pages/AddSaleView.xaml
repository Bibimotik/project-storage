<UserControl
    x:Class="application.MVVM.View.Pages.AddSaleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:application.MVVM.View.Pages"
    mc:Ignorable="d">
    
    <StackPanel Margin="50 0 50 0">
        <Label
            FontSize="45"
            Content="Add sale"/>
        <ScrollViewer Width="820" Height="590">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="400" />
                    <ColumnDefinition
                        Width="400"/>
                </Grid.ColumnDefinitions>
            
                <StackPanel Grid.Column="0" Margin="0 0 5 0">
                    <Label Content="INN"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Name="INNTextBox" Style="{StaticResource AuthInput}" Text="{Binding Inn, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="1"
                            Margin="5 0 0 0"
                            Content="GET"
                            Command="{Binding GetParserDataINNCommand}"
                            CommandParameter="{Binding Text, ElementName=INNTextBox}"
                            Style="{StaticResource SendButtonWhite}" />
                    </Grid>

                    <Label Content="KPP"/>
                    <TextBox Name="KPPTextBox" Style="{StaticResource AuthInput}" Text="{Binding Kpp, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Content="OGRN"/>
                    <TextBox Name="OGRNTextBox" Style="{StaticResource AuthInput}" Text="{Binding Ogrn, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Content="Full name"/>
                    <TextBox Name="FullNameTextBox" Style="{StaticResource AuthInput}" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Content="Address"/>
                    <TextBox Name="AddressTextBox" Style="{StaticResource AuthInput}" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Content="Payment account"/>
                    <TextBox Name="PaymentAccountTextBox" Style="{StaticResource AuthInput}" Text="{Binding PaymentAccount, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Content="For BIK"/>
                    <TextBox Name="ToBIKTextBox" Style="{StaticResource AuthInput}" Text="{Binding ToBIK, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Content="For bank"/>
                    <TextBox Name="ToBankTextBox" Style="{StaticResource AuthInput}" Text="{Binding ToBank, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Content="For cor account"/>
                    <TextBox Name="ToCorAccountTextBox" Style="{StaticResource AuthInput}" Text="{Binding ToCorAccount, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Content="From cor account"/>
                    <TextBox Name="FromCorAccountTextBox" Style="{StaticResource AuthInput}" Text="{Binding FromCorAccount, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Content="From BIK"/>
                    <TextBox Name="FromBIKTextBox" Style="{StaticResource AuthInput}" Text="{Binding FromBIK, UpdateSourceTrigger=PropertyChanged}" />
                    
                    <Label Content="From bank"/>
                    <TextBox Name="FromBankTextBox" Style="{StaticResource AuthInput}" Text="{Binding FromBank, UpdateSourceTrigger=PropertyChanged}" />
                    
                    <Button
                        Content="Back"
                        Height="27"
                        Margin="0,10,0,0"
                        Width="300"
                        Command="{Binding TriggerSalesCommand}"
                        Style="{StaticResource SendButtonWhite}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="5 0 0 0">
                    <Label Content="Full storage name" Margin="0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FullProductName" Text="{Binding FullStorageName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AuthInput}" />
                        <Button
                            Grid.Column="1"
                            Margin="5 0 0 0"
                            Content="GET"
                            Command="{Binding GetProductCommand}"
                            CommandParameter="{Binding Text, ElementName=FullStorageName}"
                            Style="{StaticResource SendButtonWhite}" />
                    </Grid>

                    <Label Content="Plan date shipment"/>
                    <DatePicker Name="PlanDateShipmentPicker" SelectedDate="{Binding PlanDateShipment, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Content="Shipping address"/>
                    <TextBox Name="ShippingAddressTextBox" Style="{StaticResource AuthInput}" Text="{Binding ShippingAddress, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Content="Application date"/>
                    <DatePicker Name="ApplicationDatePicker" SelectedDate="{Binding ApplicationDate, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Content="Delivery point"/>
                    <TextBox Name="DeliveryPointTextBox" Style="{StaticResource AuthInput}" Text="{Binding DeliveryPoint, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Content="Delivery address"/>
                    <TextBox Name="DeliveryAddressTextBox" Style="{StaticResource AuthInput}" Text="{Binding DeliveryAddress, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Content="Plan date receipt"/>
                    <DatePicker Name="PlanDateReceiptPicker" SelectedDate="{Binding PlanDateReceipt, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Content="Full name transporter"/>
                    <TextBox Name="TransporterFullNameTextBox" Style="{StaticResource AuthInput}" Text="{Binding TransporterFullName, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Content="Short name transporter"/>
                    <TextBox Name="TransporterShortNameTextBox" Style="{StaticResource AuthInput}" Text="{Binding TransporterShortName, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Content="Comment"/>
                    <TextBox Name="CommentTextBox" TextWrapping="Wrap" AcceptsReturn="True" Height="64" Style="{StaticResource AuthInput}" Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Content="VAT"/>
                    <TextBox Name="VATTextBox" Style="{StaticResource AuthInput}" Text="{Binding Vat, UpdateSourceTrigger=PropertyChanged}" />

                    <Button
                        Content="Add sale"
                        Foreground="#ffffff"
                        Margin="0,10,0,0"
                        Width="300"
                        Style="{StaticResource SendButton}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </StackPanel>
</UserControl>
